# ============================================================
# RAG-PDF — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── API Server ───────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
API_RELOAD=false            # Set true for local dev (uvicorn --reload)
LOG_LEVEL=info

# ── LLM Provider ─────────────────────────────────────────────
# Options: "gemini" | "ollama"
LLM_PROVIDER=gemini

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (used when LLM_PROVIDER=ollama)
# When running in Docker: use the service name as host
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava   # used for image/chart description

# ── Embedding Model ──────────────────────────────────────────
# Options: "local" | "gemini"
# "local" = sentence-transformers (free, runs in container)
# "gemini" = Google text-embedding-004 (requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────────────────────
# Options: "chromadb" | "pinecone"
VECTOR_STORE=chromadb

# ChromaDB (used when VECTOR_STORE=chromadb)
# "embedded" = in-process (no separate container needed)
# "server"   = connects to the chromadb service in docker-compose
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=/data/chroma_db
CHROMA_COLLECTION_NAME=rag_pdf_collection
# Only used when CHROMA_MODE=server
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Pinecone (used when VECTOR_STORE=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-pdf
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=384       # must match embedding model dimension

# ── Ingestion Settings ───────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
PDF_UPLOAD_DIR=/data/pdfs

# ── RAGAS Evaluation ─────────────────────────────────────────
# RAGAS uses the same LLM provider configured above
RAGAS_FAITHFULNESS=true
RAGAS_ANSWER_RELEVANCY=true
RAGAS_CONTEXT_PRECISION=true
RAGAS_CONTEXT_RECALL=true
